{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@/types/*": ["./src/types/*"]
    },
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
